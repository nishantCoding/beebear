{
  "name": "beebear-monorepo",
  "private": true,
  "description": "Hexagonal Architecture Framework for Node.js/TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
