{
  "name": "beebear",
  "version": "0.1.1",
  "description": "Lightweight hexagonal architecture framework for Node.js/TypeScript — decorator-free by default",
  "license": "MIT",
  "author": "nishantCoding",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nishantCoding/beebear.git",
    "directory": "packages/beebear"
  },
  "homepage": "https://github.com/nishantCoding/beebear",
  "bugs": {
    "url": "https://github.com/nishantCoding/beebear/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "keywords": [
    "hexagonal-architecture",
    "ports-and-adapters",
    "dependency-injection",
    "clean-architecture",
    "typescript",
    "framework",
    "use-case",
    "domain-driven",
    "express",
    "fastify",
    "hono"
  ]
}
