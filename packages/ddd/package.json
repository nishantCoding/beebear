{
  "name": "@beebear-plugins/ddd",
  "version": "0.1.0",
  "description": "DDD building blocks for beebear — Entity, ValueObject, AggregateRoot, DomainEvent",
  "license": "MIT",
  "author": "nishantCoding",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nishantCoding/beebear.git",
    "directory": "packages/ddd"
  },
  "homepage": "https://github.com/nishantCoding/beebear",
  "bugs": {
    "url": "https://github.com/nishantCoding/beebear/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  },
  "keywords": [
    "beebear",
    "ddd",
